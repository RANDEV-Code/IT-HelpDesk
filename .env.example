# RANDesk — contoh konfigurasi lingkungan (OPERATIONS.md §2)
# Salin menjadi .env untuk development; JANGAN commit .env dan JANGAN isi nilai rahasia di file ini.

# development | test | staging | production
# Production menolak start bila konfigurasi tidak aman (OPERATIONS §2).
APP_ENV=development

# Origin browser yang sah (scheme + host + port, tanpa wildcard) — dipakai validasi Origin/CSRF.
APP_ORIGIN=http://localhost:5173

# Bind address API. Privat di belakang reverse proxy pada deployment.
HTTP_ADDR=127.0.0.1:8080

# Koneksi PostgreSQL (SECRET — tidak boleh dilog).
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=

# Direktori lampiran (path privat, writable oleh proses API, persistent).
STORAGE_ROOT=./storage

# Masa aktif sesi dalam jam. Default 8 (SECURITY §3); perubahan memerlukan review UX/security.
SESSION_TTL_HOURS=8

# Verbosity log: debug | info | warn | error. Info di production; tanpa body sensitif.
LOG_LEVEL=debug

# Proxy yang dipercaya — daftar eksplisit dipisah koma, bukan seluruh internet.
# Kosongkan pada development langsung.
TRUSTED_PROXIES=

# Batas pool koneksi DB (baseline OPERATIONS §2; ukur pool wait sebelum mengubah).
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
